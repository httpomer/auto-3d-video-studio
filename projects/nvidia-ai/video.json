     },
     "camera": {
      "from": "wide",
      "to": "close"
     },
     "overlays": [
      {
       "type": "tag",
       "text": "2012 · AlexNet",
       "at": 0.4
      }
     ]
    },
    {
     "narration": "Four years later, Jensen Huang personally delivered NVIDIA's first AI supercomputer to a small research lab called OpenAI.",
     "scene": "timeline",
     "params": {
      "events": [
       {
        "year": "1993",
        "title": "NVIDIA founded"
       },
       {
        "year": "1999",
        "title": "GeForce 256"
       },
