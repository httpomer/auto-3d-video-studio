        "sub": "Trained on two NVIDIA GPUs"
       },
       {
        "year": "2016",
        "title": "First AI supercomputer",
        "sub": "Delivered to OpenAI"
       },
       {
        "year": "2022",
        "title": "ChatGPT launches"
       }
      ],
      "active": 3,
      "activeFrom": 2
     },
     "camera": {
      "from": "at2",
      "to": "at3"
     }
    },
    {
     "narration": "It crushed every rival at recognizing images. And the modern AI boom began.",
     "scene": "neural_network",
     "params": {
      "layers": [
       5,
       8,
       8,
       6,
       3
      ],
      "labels": [
       "Image",
       "",
